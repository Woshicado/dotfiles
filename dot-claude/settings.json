{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:docs": "on",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:pdf": "on",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:xlsx": "on",
    "find-skills": "off",
    "frontend-design": "user-invocable-only",
    "grill-me": "user-invocable-only",
    "python-testing-patterns": "user-invocable-only",
    "slurm-cluster": "on",
    "spanish-anki": "user-invocable-only",
    "web-artifacts-builder": "on",
    "webapp-testing": "user-invocable-only",
    "workstation": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/compute-guard.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status tool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          },
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh notify"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh done"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh clear"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status clear"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
}
