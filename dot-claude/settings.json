{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status tool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          },
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh working"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh notify"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh done"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/sketchybar/helpers/claude_status.sh clear"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/zellij-claude-status clear"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell"
}
