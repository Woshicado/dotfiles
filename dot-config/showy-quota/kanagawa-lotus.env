# showy-quota -- kanagawa lotus (light).
# BG is the light bar background so the strip blends rather than blocks.
: "${SHOWY_QUOTA_PALETTE_BG:=f2ecbc}"
: "${SHOWY_QUOTA_PALETTE_SURFACE:=e5ddb0}"
: "${SHOWY_QUOTA_PALETTE_TRACK:=dcd5a0}"

# Pastel rather than kanagawa's saturated syntax colours
: "${SHOWY_QUOTA_PALETTE_PRIMARY_GOOD:=8ba86b}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_WARN:=c9a227}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_BAD:=c84053}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_UNKNOWN:=b3b1a4}"

# Default 0.55 crushed the dimmed weekly row to #3d4b2
: "${SHOWY_QUOTA_PALETTE_DIM_SCALE:=0.85}"

: "${SHOWY_QUOTA_PALETTE_ICON_TEXT:=545464}"
: "${SHOWY_QUOTA_PALETTE_COUNTDOWN:=8a8980}"
: "${SHOWY_QUOTA_PALETTE_COUNTDOWN_WARN:=cc6d00}"
: "${SHOWY_QUOTA_PALETTE_ELAPSED:=b98aa0}"
: "${SHOWY_QUOTA_PALETTE_ELAPSED_LONG:=7fb0c0}"

# Pointy powerline caps instead of the default rounded half-circles
: "${SHOWY_QUOTA_CAP_LEFT:=}"
: "${SHOWY_QUOTA_CAP_RIGHT:=}"

# Show only Claude, the only subscription I have
# SHOWY_QUOTA_PROVIDERS="claude,codex" # show both if I want
: "${SHOWY_QUOTA_PROVIDERS:=claude}"
