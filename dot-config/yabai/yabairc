yabai -m rule --add app="^Spotify$" manage=off
yabai -m rule --add app="^[Ww]hats[Aa]pp$" manage=off
yabai -m rule --add app="^[Ss]ignal$" manage=off
yabai -m rule --add app="^[Zz]otero$" title="([Zz]ot[Ss]eek|[Pp]lugins [Mm]anager|[Zz]otero [Ss]ettings)" manage=off
yabai -m rule --add app="^Thunderbird$" title="(Write:)" manage=off
yabai -m rule --add app="^Zen$" title="^Extension:" manage=off
yabai -m rule --add app="^qemu-system-aarch64$" manage=off
