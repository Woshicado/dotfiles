#!/usr/bin/env zsh

pdfextract() {
  [[ -f "$1" && -n "$2" && -n "$3" ]] || {
    print -u2 "usage: pdfextract <file.pdf> <page> <name> [out.pdf]"; return 1 }
  local out="${4:-/tmp/${3#/}.pdf}"
  uv run --with pikepdf python - "$1" "$2" "$3" "$out" <<'PY'
import sys, pikepdf
src_pdf, page_no, name, out = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
pdf = pikepdf.open(src_pdf)
xo = pdf.pages[page_no - 1]["/Resources"]["/XObject"][name if name.startswith("/") else "/" + name]
bbox = xo.BBox
w, h = float(bbox[2]) - float(bbox[0]), float(bbox[3]) - float(bbox[1])
new = pikepdf.new()
page = new.add_blank_page(page_size=(w, h))
page.add_overlay(xo)
new.save(out)
print(out)
PY
  [[ -f "$out" ]] && print "wrote $out"
}
