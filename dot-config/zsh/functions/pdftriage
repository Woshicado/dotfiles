#!/usr/bin/env zsh

pdftriage() {
  [[ -f "$1" ]] || { print -u2 "usage: pdftriage <file.pdf>"; return 1 }
  local wreport preport worst
  wreport=$(pdfweight "$1") || return 1
  preport=$(pdfpaths "$1") || return 1

  print -P "%B── heaviest pages (bytes) ──%b"
  print -r -- "$wreport" | head -5

  print -P "\n%B── slowest pages (path ops) ──%b"
  print -r -- "$preport" | head -5

  worst=${${(z)$(print -r -- "$preport" | head -1)}[-1]}
  [[ -n "$worst" ]] || { print -u2 "couldn't determine worst page"; return 1 }

  print -P "\n%B── XObjects on page $worst ──%b"
  pdfxobj "$1" "$worst"
}
