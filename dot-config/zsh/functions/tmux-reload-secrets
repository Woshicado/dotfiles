#!/usr/bin/env bash

# Re-decrypt secrets.env and refresh both caches:
#   1. the current shell's exported vars
#   2. the tmux server's global env, which new panes inherit
# Mirrors the one-time loader in exports.zsh. Run after editing secrets.env.
tmux-reload-secrets() {
  local secrets_file="${HOME}/dotfiles/secrets.env"
  local plain line count=0

  if ! plain="$(sops --decrypt "$secrets_file")"; then
    print -u2 "tmux-reload-secrets: sops decrypt failed for $secrets_file"
    return 1
  fi

  # 1. Refresh the current shell. Split on the first '=' only so values may
  #    contain '=' or spaces (unlike the exports.zsh `xargs` path).
  while IFS= read -r line; do
    [[ -z $line || $line == '#'* ]] && continue
    export "${line%%=*}=${line#*=}"
    (( count++ ))
  done <<< "$plain"

  # 2. Refresh the tmux global env so future panes inherit the new values.
  if [[ -n ${TMUX:-} ]] && (( $+commands[tmux] )); then
    while IFS= read -r line; do
      [[ -z $line || $line == '#'* ]] && continue
      tmux setenv -g "${line%%=*}" "${line#*=}"
    done <<< "$plain"
    tmux setenv -g SECRETS_LOADED 1
  else
    print -u2 "tmux-reload-secrets: not inside tmux — refreshed current shell only"
  fi

  print "tmux-reload-secrets: reloaded ${count} vars"
}
