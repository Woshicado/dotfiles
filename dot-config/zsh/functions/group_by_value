#!/usr/bin/env zsh

# Usage: group-by-value <key> <path-filter> [<path-filter> ...] <file_glob>
#   group-by-value latent_dist_percentile '*dqn*' config.yaml
group-by-value() {
  emulate -L zsh
  local key="$1"
  shift
  local -a args=("$@")

  if [[ -z "$key" || ${#args[@]} -eq 0 ]]; then
    echo "usage: rg-group-by-value <key> [path-filter ...] <file_glob>" >&2
    return 1
  fi

  local file_glob="${args[-1]}"
  local -a path_filters=("${args[@]:0:${#args[@]}-1}")

  local combined="**"
  for f in "${path_filters[@]}"; do
    combined="${combined}/${f}/**"
  done
  combined="${combined}/${file_glob}"

  rg -H -oP "${key}:\s*\K\S+" \
     -g "$combined" \
     -g '!/*_*/**' \
     -L \
  | awk -F: '{print $2, $1}' \
  | sort -k1,1 \
  | awk '{if ($1 != prev) {print "\n=== " $1 " ==="; prev=$1} print "  " $2}'
}
