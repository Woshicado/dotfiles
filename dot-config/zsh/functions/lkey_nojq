lkey_nojq() {
  local filename="progress.jsonl"

  local OPTIND opt
  while getopts "f:" opt; do
    case $opt in
    f) filename="$OPTARG" ;;
    *) return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ $# -eq 0 ]]; then
    set -- "time/total_timesteps"
  fi

  find -L . -name "$filename" -exec sh -c '
    file="$1"; shift
    out="$file"
    for key in "$@"; do
      last_line=$(grep "\"$key\":" "$file" | tail -n 1)
      val=$(echo "$last_line" | sed -rn "s@.*\"$key\":\s*([+-]?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?).*@\1@p")
      [ -n "$val" ] && out="$out  $key=$val"
    done
    echo "$out"
  ' sh "{}" "$@" \;
}
